{
  "name": "nuxt-lettermint",
  "version": "2.0.0",
  "description": "Nuxt module for sending emails with Lettermint",
  "author": "Bjorn Antonissen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lettermint/nuxt-lettermint.git"
  },
  "bugs": {
    "url": "https://github.com/lettermint/nuxt-lettermint/issues"
  },
  "homepage": "https://github.com/lettermint/nuxt-lettermint#readme",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "email",
    "lettermint",
    "mail",
    "smtp",
    "transactional-email"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "UPGRADE.md"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "semantic-release",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "release:dry": "semantic-release --dry-run --no-ci"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.2",
    "defu": "^6.1.4",
    "h3": "^1.15.11",
    "lettermint": "^2.4.1"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.1.1",
    "@nuxt/eslint-config": "^1.12.1",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.2",
    "@nuxt/test-utils": "^4.0.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "nuxt": "^4.4.2",
    "semantic-release": "^25.0.3",
    "typescript": "~7.0.2",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.2.1"
  }
}
